       <layout class="QHBoxLayout" name="horizontalLayoutMixerStyle">
        <item>
         <widget class="QLabel" name="labelMixerStyle">
          <property name="text">
           <string>Speak mixer values as:</string>
          </property>
          <property name="toolTip">
