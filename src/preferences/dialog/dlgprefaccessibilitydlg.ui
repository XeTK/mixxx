        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxAnnounceMixer">
        <property name="toolTip">
         <string>Speak volume faders, EQ knobs, and the crossfader after they stop moving. Off by default because these move constantly during a mix.</string>
        </property>
        <property name="text">
         <string>Announce mixer controls (volume, EQ, crossfader)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxAnnounceWhileMoving">
        <property name="toolTip">
         <string>Speak knob and fader values while they move (at most a few times per second) instead of only once they come to rest.</string>
        </property>
        <property name="text">
         <string>Announce controls while they move</string>
        </property>
       </widget>
      </item>
